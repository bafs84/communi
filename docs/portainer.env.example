# Import this file into Portainer's stack environment editor, then replace EVERY
# replace-* value. It contains no real credentials. See PORTAINER.md.
PUBLIC_AUTH0_DOMAIN=communi.eu.auth0.com
PUBLIC_AUTH0_CLIENT_ID=replace-with-auth0-spa-client-id
PUBLIC_AUTH0_AUDIENCE=https://api.communi.ch
PUBLIC_AUTH0_REDIRECT_URI=https://communi.ch/raum/
PUBLIC_API_BASE_URL=
PUBLIC_CKW_PORTAL_URL=https://communi.ch/raum/ckw/
AUTH0_AUDIENCE=https://api.communi.ch
AUTH0_ISSUER_BASE_URL=https://communi.eu.auth0.com/
CORS_ORIGINS=https://communi.ch,https://www.communi.ch,https://ckw.communi.ch
POSTGRES_DB=communi
POSTGRES_USER=communi
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
S3_BUCKET=communi-private
S3_REGION=garage
S3_ACCESS_KEY_ID=replace-with-GK-followed-by-openssl-rand-hex-12
S3_SECRET_ACCESS_KEY=replace-with-openssl-rand-hex-32
GARAGE_RPC_SECRET=replace-with-openssl-rand-hex-32
DATA_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
CKW_INTERNAL_TOKEN=replace-with-openssl-rand-hex-48
CLOUDFLARED_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
