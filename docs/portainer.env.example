# Set these external account values in Portainer. Internal secrets are generated
# once on first startup and persisted in Docker volumes automatically.
PUBLIC_AUTH0_DOMAIN=communi.eu.auth0.com
PUBLIC_AUTH0_CLIENT_ID=replace-with-auth0-spa-client-id
CLOUDFLARED_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Optional: must match the Auth0 API identifier you configure.
PUBLIC_AUTH0_AUDIENCE=https://api.communi.ch
