---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/site";
import Hero from "../../components/widgets/Hero.astro";
import Card from "../../components/ui/Card.astro";
import Button from "../../components/ui/Button.astro";

const metadata = {
  title: `ZEV – Einstieg & Umsetzung | ${siteConfig.name}`,
  description:
    "ZEV verständlich planen und umsetzen: Rollen, Messung/Abrechnung, Verträge, Kommunikation – mit Fokus auf Alltagstauglichkeit.",
};
---

<BaseLayout {metadata}>
  <Hero
    title={`ZEV: vom Konzept zur <span class="bg-linear-to-r from-blue-500 to-indigo-500 bg-clip-text text-transparent">funktionierenden</span> Gemeinschaft`}
    tagline="Themenseite · ZEV"
    description="Ein ZEV steht und fällt mit klaren Rollen, einem sauberen Mess-/Abrechnungskonzept und verständlicher Kommunikation."
    actions={[
      { text: "ZEV Grundlagen", href: "/wissen/zev-grundlagen/", variant: "primary", icon: "lucide:book-open" },
      { text: "Messung & Abrechnung", href: "/wissen/messung-und-abrechnung/", variant: "secondary", icon: "lucide:gauge" },
      { text: "Projektkontext", href: "/dienstleistungen/", variant: "secondary", icon: "lucide:flask-conical" },
    ]}
  />

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <Card>
        <h2 class="text-xl font-bold text-foreground mb-2">Typische Fragen</h2>
        <ul class="text-sm text-muted-foreground space-y-2 list-disc pl-5">
          <li>Wer übernimmt Betreiber-/Verwalterrolle?</li>
          <li>Wie werden Eigenverbrauch und Kosten fair verteilt?</li>
          <li>Wie aufwändig ist der Betrieb im Alltag?</li>
        </ul>
      </Card>
      <Card>
        <h2 class="text-xl font-bold text-foreground mb-2">Unsere Hilfen</h2>
        <ul class="text-sm text-muted-foreground space-y-2 list-disc pl-5">
          <li>Entscheidungs-Checklisten und Vorlagen</li>
          <li>Struktur für Messung, Abrechnung und Kommunikation</li>
          <li>Moderation von Eigentümer-/Mieter-Dialogen</li>
        </ul>
      </Card>
      <Card>
        <h2 class="text-xl font-bold text-foreground mb-2">Ergebnis</h2>
        <ul class="text-sm text-muted-foreground space-y-2 list-disc pl-5">
          <li>Klare Governance</li>
          <li>Nachvollziehbare Abrechnung</li>
          <li>Geringe Reibung im Betrieb</li>
        </ul>
      </Card>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-20">
    <Card class="max-w-4xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h2 class="text-xl font-bold text-foreground mb-2">Schon ein (virtueller) ZEV in Betrieb?</h2>
          <p class="text-sm text-muted-foreground">
            Dann geht es häufig um Batterie, E-Mobilität, Optimierung und eine Roadmap Richtung LEG – ohne dass die Abrechnung explodiert.
          </p>
        </div>
        <Button href="/zielgruppen/bestehender-zev/" variant="secondary">Zur Zielgruppen-Seite</Button>
      </div>
    </Card>
  </section>
</BaseLayout>
