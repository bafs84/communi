---
import BaseLayout from "./BaseLayout.astro";

const { title, description, metadata } = Astro.props;
---

<BaseLayout {title} {description} {metadata}>
    <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12">
        <article class="prose prose-zinc max-w-none prose-headings:scroll-mt-24">
            <slot />
        </article>
    </section>
</BaseLayout>
