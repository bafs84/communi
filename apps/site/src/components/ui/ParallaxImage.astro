---
import type { ImageMetadata } from "astro";

interface Props {
    image: ImageMetadata;
    alt: string;
    eyebrow?: string;
    title?: string;
    description?: string;
}

const { image, alt, eyebrow, title, description } = Astro.props as Props;
---

<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6 md:py-10">
    <div class="relative min-h-[340px] overflow-hidden rounded-[2rem] border border-border md:min-h-[460px]">
        <div
            class="absolute inset-0 scale-110 bg-cover bg-center bg-scroll md:bg-fixed"
            style={`background-image: url(${image.src});`}
            role="img"
            aria-label={alt}
        />
        <div class="absolute inset-0 bg-linear-to-t from-black/55 via-black/20 to-white/0" />
        <div class="relative z-10 flex min-h-[340px] items-end p-8 md:min-h-[460px] md:p-12">
            <div class="max-w-2xl text-white">
                {eyebrow && (
                    <p class="mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-white/75">
                        {eyebrow}
                    </p>
                )}
                {title && (
                    <h2 class="mb-3 text-3xl font-bold tracking-tight md:text-5xl">
                        {title}
                    </h2>
                )}
                {description && (
                    <p class="max-w-xl text-sm leading-relaxed text-white/85 md:text-base">
                        {description}
                    </p>
                )}
            </div>
        </div>
    </div>
</section>
