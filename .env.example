# Public browser configuration (not secrets)
PUBLIC_AUTH0_DOMAIN=communi.eu.auth0.com
PUBLIC_AUTH0_CLIENT_ID=replace-with-auth0-spa-client-id
PUBLIC_AUTH0_AUDIENCE=https://api.communi.ch
PUBLIC_AUTH0_REDIRECT_URI=https://communi.ch/raum/
PUBLIC_API_BASE_URL=
PUBLIC_CKW_PORTAL_URL=https://communi.ch/raum/ckw/
PUBLIC_CKW_GUEST_URL=https://ckw.communi.ch/

# API and database
POSTGRES_DB=communi
POSTGRES_USER=communi
POSTGRES_PASSWORD=replace-with-long-random-password
HOST=0.0.0.0
PORT=4100
CORS_ORIGINS=https://communi.ch,https://www.communi.ch,https://ckw.communi.ch
AUTH0_AUDIENCE=https://api.communi.ch
AUTH0_ISSUER_BASE_URL=https://communi.eu.auth0.com/
CKW_ENGINE_URL=http://ckw-engine:8000
MAX_FILE_BYTES=10485760
GUEST_SESSION_MAX_BYTES=52428800
REGISTERED_USER_MAX_BYTES=1073741824
GUEST_IDLE_MINUTES=60
GUEST_MAX_HOURS=24
MAINTENANCE_INTERVAL_SECONDS=300

# Private S3-compatible Garage storage
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=communi-private
S3_ACCESS_KEY_ID=GK000000000000000000000000
S3_SECRET_ACCESS_KEY=replace-with-64-character-random-hex-secret
S3_FORCE_PATH_STYLE=true

# Development-only defaults. Production injects these using Docker secrets.
DATA_ENCRYPTION_KEY_FILE=/run/secrets/data_encryption_key
CKW_INTERNAL_TOKEN_FILE=/run/secrets/ckw_internal_token
CLOUDFLARED_TOKEN_FILE=/run/secrets/cloudflared_token
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.8.2
